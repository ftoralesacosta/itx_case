// Fit trims, total mm (negative grows). Local X -> world X, local Y -> world Z for C14_ROT = [270,180,0].
C14_FLANGE_TRIM_X = 0.25;
C14_FLANGE_TRIM_Z = 1.0;
C14_BODY_TRIM_X   = 0;
C14_BODY_TRIM_Z   = 0;

// Keeps corner radii; valid while each straight side is longer than |d|.
module c14_trim_2d(dx, dy) {
    module ax(d, v) {
        if (d > 0)      intersection() { translate(-v*d/2) children(); translate(v*d/2) children(); }
        else if (d < 0) hull()         { translate(-v*d/2) children(); translate(v*d/2) children(); }
        else            children();
    }
    ax(dx, [1, 0]) ax(dy, [0, 1]) children();
}

module c14_solid_tool() {
    union() {
        translate([0,0, -0.01])
        linear_extrude(height=3.0)
            c14_trim_2d(C14_FLANGE_TRIM_X, C14_FLANGE_TRIM_Z)
                offset(r=0.3) c14_flange_profile();

        translate([0,0,-30])
        linear_extrude(height=35)
            c14_trim_2d(C14_BODY_TRIM_X, C14_BODY_TRIM_Z)
                offset(r=0.3) c14_body_profile();
    }
}
